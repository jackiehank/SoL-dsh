{
  "name": "@local/sol-dsh",
  "version": "0.8.0",
  "type": "module",
  "description": "SoL-Pi 四种效率机制在 DSH 上的移植（默认全关）",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jackiehank/SoL-dsh.git"
  },
  "homepage": "https://github.com/jackiehank/SoL-dsh",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "agent",
    "context-engineering",
    "sol-pi"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/*.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/cosmokit": "1.8.6",
    "@deepseek-ai/schemastery": "3.18.5"
  }
}
